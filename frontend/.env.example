# Production API origin, no trailing slash. Leave empty in development (Vite proxies /api to :8000).
# A production build without this points at the Vercel origin and every request fails.
VITE_API_BASE=https://canopy-api.onrender.com

# CARTO basemap key (free non-commercial tier: https://carto.com/basemaps/apikey).
# Without it the basemap tiles carry an "API KEY REQUIRED" watermark.
VITE_CARTO_API_KEY=
